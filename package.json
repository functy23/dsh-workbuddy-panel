{
  "name": "dsh-workbuddy-panel",
  "displayName": "DSH WorkBuddy Panel",
  "description": "把 workbuddy2api 网关托管进 DSH：面板与内核分离，服务端单独下载，宿主组合行通过 ctx.subprocess 托管进程；账号、模型目录与思考档位全部在 DSH 内管理。",
  "version": "0.5.0",
  "author": "Functy",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "workbuddy",
    "workbuddy2api",
    "model-provider",
    "gateway"
  ],
  "icon": "./icon.svg",
  "type": "module",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsdown",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.client.json",
    "check": "pnpm run build && pnpm run typecheck && pnpm run test",
    "server:build": "node scripts/build-server-release.mjs",
    "server:manifest": "node scripts/write-server-manifest.mjs",
    "server:install-local": "node scripts/install-local-server.mjs",
    "release:npm": "npm publish --access public"
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./gateway": {
      "types": "./lib/gateway.d.ts",
      "default": "./lib/gateway.js"
    },
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "server.json",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "locale"
  ],
  "license": "MIT",
  "dependencies": {
    "@earendil-works/pi-ai": "0.87.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-model-selection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-attachment": "^0.1.7-alpha.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-layout": "^0.1.7-alpha.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.1.7-alpha.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.7-alpha.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-sidebar": "^0.1.7-alpha.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.7-alpha.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-model-selection": "^0.1.7-alpha.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-home-paths": "^0.1.7-alpha.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.7-alpha.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.7-alpha.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.7-alpha.1 || ^0.2.0-rc.1",
    "@deepseek-ai/dsh-settings": "^0.1.7-alpha.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.3",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.3",
    "@deepseek-ai/dsh-attachment": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-model-selection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-home-paths": "0.2.0-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm-pi-ai": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "^3.18.4",
    "@types/node": "^22.20.0",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "react": "^18.2.0",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/functy23/dsh-workbuddy-panel.git"
  },
  "homepage": "https://github.com/functy23/dsh-workbuddy-panel#readme",
  "bugs": {
    "url": "https://github.com/functy23/dsh-workbuddy-panel/issues"
  }
}
